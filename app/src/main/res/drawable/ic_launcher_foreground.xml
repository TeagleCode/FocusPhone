<?xml version="1.0" encoding="utf-8"?>
<!--
    The FocusMark: a session ring with a deliberate gap, and a fixed centre dot.
    The loop does not close on its own.

    Generated by tools/brand_assets.py — edit the constants there, not this
    file. In the source design this is a conic gradient behind a radial mask;
    it is re-cut here as a stroked arc, which renders identically and is the
    only form a VectorDrawable can hold.

    The mark occupies 56% of the 108dp canvas, so its 52.0dp
    width clears the 66dp safe circle no matter which mask a launcher applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring: 259.2deg of arc from 118deg, leaving a 100.8deg gap. -->
    <path
        android:strokeColor="#F5F4F1"
        android:strokeWidth="13.8481"
        android:strokeLineCap="butt"
        android:pathData="M45.0415,70.8484 A19.0820,19.0820 0 1 1 72.2287,59.6427" />

    <!-- Centre dot. -->
    <path
        android:fillColor="#F5F4F1"
        android:pathData="M54.0,49.4640 A4.5360,4.5360 0 1 0 54.0,58.5360 A4.5360,4.5360 0 1 0 54.0,49.4640 Z" />
</vector>
